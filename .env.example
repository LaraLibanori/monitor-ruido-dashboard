# .env.example - modelo de configuração
# Copie para .env e troque os valores:  cp .env.example .env
# O .env de verdade NUNCA vai para o GitHub.

# PostgreSQL
POSTGRES_DB=noisedb
POSTGRES_USER=noiseuser
POSTGRES_PASSWORD=troque-esta-senha

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Flutter Web local (portas variáveis são permitidas para localhost/127.0.0.1)
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1

# Lei do silêncio (horários no formato HH:MM)
APP_TIMEZONE=America/Sao_Paulo
SILENCE_START_WEEKDAY=22:00
SILENCE_START_WEEKEND=15:00
SILENCE_END=09:00

# App Android: sensor sem enviar há mais que isso (segundos) aparece como "sem sinal"
OFFLINE_AFTER_SECONDS=60

# ---------- Login e sessões ----------
# Chave usada para proteger os tokens de sessão e convite. OBRIGATÓRIA em uso real.
# Gere uma com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_HOURS=12
INVITE_TTL_HOURS=72
# true = o app só mostra as casas depois do login (recomendado quando todos já tiverem conta)
APP_REQUIRE_AUTH=false
# Endereço que vai nos links de convite (ex.: http://192.168.0.139:5000).
# Vazio = usa o endereço pelo qual o administrador abriu o painel.
PUBLIC_BASE_URL=

# ---------- Alertas ----------
# Intervalo mínimo, em minutos, entre dois alertas do mesmo sensor
ALERT_COOLDOWN_MINUTES=15

# ---------- E-mail (SMTP) ----------
# Sem SMTP_HOST o sistema funciona em modo simulado: registra o envio como "simulado" e não envia nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- Push (Firebase Cloud Messaging) ----------
# 1) No console do Firebase: Configurações do projeto > Contas de serviço > Gerar nova chave privada
# 2) Salve o arquivo como secrets/firebase.json (a pasta secrets/ não vai para o Git)
# 3) Descomente a linha abaixo
# FCM_CREDENTIALS_PATH=/run/secrets/firebase.json
FCM_CREDENTIALS_PATH=
